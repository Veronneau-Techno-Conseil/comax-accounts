{
  "DbConfig": {
    "MemoryDb": false,
    "Provider": "sqlite",
    "ConnectionString": "Data Source=Application.db;Cache=Shared",
    "ShouldDrop": false,
    "ShouldMigrate": true
  },
  "Initialize": "true",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "certFolder": "./",
  "PubCaptcha": "",
  "CaptchaSecret": "",
  "Urls": "https://*:5002",
  "AuthCert": "./cert.pem",
  "AuthKey": "./key.pem",
  "BaseAddress": "https://localhost:5002/",
  "Prod":  "false"
}
